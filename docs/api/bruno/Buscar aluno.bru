meta {
  name: Buscar aluno
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/users?role=ALUNO
  body: none
  auth: bearer
}

params:query {
  role: ALUNO
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
}

script:post-response {
  // Acha o aluno pelo e-mail do ambiente (studentEmail): quem se cadastrou no app durante a demo
  const email = bru.getEnvVar("studentEmail");
  const aluno = res.body.find((u) => u.email === email);
  if (!aluno) throw new Error("Aluno " + email + " não encontrado. Cadastre no app ou ajuste studentEmail no ambiente.");
  bru.setVar("studentId", aluno.id);
}
