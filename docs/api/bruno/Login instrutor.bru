meta {
  name: Login instrutor
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{instructorEmail}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("instructorToken", res.body.accessToken);
  bru.setVar("instructorId", res.body.user.id);
}
