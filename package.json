{
  "name": "pies-academia",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "npm -w apps/api run dev",
    "dev:worker": "npm -w apps/api run dev:worker",
    "dev:mobile": "npm -w apps/mobile run start",
    "db:migrate": "npm -w apps/api run prisma:migrate",
    "db:seed": "npm -w apps/api run prisma:seed",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
