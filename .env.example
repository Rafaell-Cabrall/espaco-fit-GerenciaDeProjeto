# copie para .env na raiz. api e docker-compose leem daqui.
DATABASE_URL=postgresql://espacofit:espacofit@localhost:5433/espacofit
REDIS_URL=redis://localhost:6380
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Windows com WSL/Hyper-V reserva faixas de porta ao acaso e a 3000 pode cair numa delas: o listen
# dá EACCES. Confira com `netsh interface ipv4 show excludedportrange protocol=tcp` e, se cair,
# troque aqui e no EXPO_PUBLIC_API_URL (4000 costuma estar livre).
PORT=3000

# MinIO (S3 local). O endpoint entra na assinatura das URLs de mídia: para testar no celular,
# use o mesmo IP do EXPO_PUBLIC_API_URL, não localhost.
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=media
S3_ACCESS_KEY=espacofit
S3_SECRET_KEY=espacofit123

# E-mail (código de recuperação de senha), enviado pelo worker. Vazio = o worker só imprime no console.
# Gmail: ative a verificação em 2 etapas e gere uma senha de app em https://myaccount.google.com/apppasswords
# (16 letras, sem espaços). Use uma conta criada para o projeto, não a pessoal.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# mobile: IP da máquina que roda a API (celular na mesma rede). Trocar a cada rede nova:
# `ipconfig` no Windows, `ip addr` no Linux. localhost aqui seria o próprio celular.
# O `npm run dev:mobile` lê este arquivo da raiz via dotenv; sozinho, o Expo só leria
# apps/mobile/.env e o app cairia no fallback localhost:3000 do client.ts.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
