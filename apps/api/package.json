{
  "name": "@espacofit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "test": "node --test --env-file-if-exists=../../.env \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@espacofit/shared": "*",
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.3.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2"
  }
}